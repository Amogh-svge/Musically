APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rbac_admin
DB_USER=root
DB_PASSWORD=

API_PREFIX=/api/v1

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_TTL=86400

# Comma-separated allowed browser origins. With APP_DEBUG=true, any http(s)://localhost
# or 127.0.0.1 with any port is also accepted so Vite can use 5173, 5177, etc.
CORS_ORIGIN=http://localhost:5173,http://localhost:5177